# Cloud.gov staticfile buildpack config.
# Assembled into out/ at build time by scripts/build-cloudgov.mjs.
# root:public separates the web content from the nginx config dir, which
# location_include requires. The include sets absolute_redirect off so the
# trailing-slash directory redirect stays relative and preserves https behind
# cloud.gov's TLS-terminating router. See cloudfoundry/staticfile-buildpack #137.
root: public
location_include: includes/*.conf
