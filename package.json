{
  "name": "semper-admin-portal",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "next": {
      "postcss": "^8.5.26",
      "sharp": "^0.35.5"
    },
    "js-yaml": "^3.15.2",
    "argparse": "^2.0.1",
    "source-map-js": "^1.2.2"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudgov": "node scripts/build-cloudgov.mjs",
    "lint": "eslint . --max-warnings=10",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:thumbnails": "node scripts/sync-thumbnails.mjs",
    "videos:generate": "node scripts/generate-videos.js",
    "pretype-check": "node scripts/generate-videos.js && node scripts/sync-content.mjs && node scripts/sync-thumbnails.mjs",
    "type-check": "tsc --noEmit",
    "prelint": "node scripts/generate-videos.js && node scripts/sync-content.mjs",
    "content:sync": "node scripts/generate-videos.js && node scripts/sync-content.mjs",
    "code:json": "node scripts/generate-code-json.mjs",
    "citations:import": "python scripts/citations-import.py",
    "citations:audit": "python scripts/citations-audit.py",
    "links:import": "python scripts/links-import.py",
    "videos:pull": "python scripts/sync-videos.py",
    "videos:audit": "python scripts/sync-videos.py --check",
    "prebuild": "node scripts/generate-videos.js && node scripts/sync-content.mjs && node scripts/sync-thumbnails.mjs",
    "predev": "node scripts/generate-videos.js && node scripts/sync-content.mjs && node scripts/sync-thumbnails.mjs",
    "search:index": "pagefind --site out --output-path out/pagefind",
    "postbuild": "node scripts/sync-content.mjs && next-sitemap && pagefind --site out --output-path out/pagefind && node scripts/check-crossrole-links.mjs --strict && node scripts/check-internal-links.mjs --strict",
    "links:crossrole": "node scripts/check-crossrole-links.mjs",
    "links:internal": "node scripts/check-internal-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.7",
    "@fontsource/bebas-neue": "^5.2.7",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/file-saver": "^2.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.15.3",
    "file-saver": "^2.0.5",
    "gray-matter": "^4.0.3",
    "immer": "^11.2.9",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "^5.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "next-sitemap": "^4.2.3",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
